@model IReadOnlyList<TeamMemberViewModel>
@{ ViewData["Title"] = "Team directory"; }
<header class="page-heading">
    <p class="page-label">Our group</p>
    <h1>Team directory</h1>
    <p class="lead">Our profiles and projects, in one place.</p>
</header>
<div class="card-grid">
@foreach (var member in Model)
{
    <article class="card member-card">
        <span class="initials" aria-hidden="true">@member.Initials</span>
        <h2>@member.Name</h2>

        @if (member.Initials == "MM")
        {
            <p class="muted">View my work.</p>
            <div class="link-row">
                <a class="button" asp-controller="Home" asp-action="F3">
                    View portfolio &rarr;
                </a>
            </div>
        }
        else if (member.IsAvailable)
        {
            <p class="muted">Read a bit about me or take a look at my projects.</p>
            <div class="link-row">
                <a asp-controller="@member.Controller" asp-action="Index">Profile</a>
                <a asp-controller="@member.Controller" asp-action="Portfolio">Portfolio</a>
            </div>
        }
        else
        {
            <p class="status">Coming soon</p>
            <p class="muted">This member's pages will be added here.</p>
        }
    </article>
}
</div>
<p class="directory-note muted">We're adding our pages separately, so some profiles are still in progress.</p>